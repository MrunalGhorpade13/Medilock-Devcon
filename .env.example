# ─── Contracts (Hardhat) ───────────────────────────────────────────
# Sepolia RPC endpoint (Alchemy / Infura / public)
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID

# Deployer wallet private key (no 0x prefix required by some tools, but safe to include)
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Etherscan API key for contract verification
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY

# ─── Frontend (Vite) ────────────────────────────────────────────────
# WalletConnect Project ID (get one free at https://cloud.walletconnect.com)
VITE_WALLETCONNECT_PROJECT_ID=YOUR_WALLETCONNECT_PROJECT_ID

# Pinata JWT for IPFS uploads (optional – if omitted, on-chain fallback is used)
VITE_PINATA_JWT=YOUR_PINATA_JWT_HERE

# Pinata gateway base URL (optional, defaults to public gateway)
VITE_PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs/
